    "import pandas as pd\n",
    "\n",
    "INFERENCE_CSV = \"./ner_entities.csv\"\n",
    "\n",
    "entities = pd.read_csv(INFERENCE_CSV)\n",
    "\n",
    "text_counts = entities[\"text\"].value_counts()  # sorted DESC by default\n",
    "multi_word_counts = text_counts[text_counts.index.str.split().str.len() > 1]\n",
    "\n",
    "print(multi_word_counts.head(30))"
